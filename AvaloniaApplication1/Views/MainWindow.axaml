<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Полифонический синтезатор"
        Width="780"
        Height="600"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="ToggleButton.key">
            <Setter Property="Height" Value="84" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Text="Полифонический синтезатор" FontSize="24" FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Margin="0,24,0,0"
                Padding="20"
                CornerRadius="10"
                BorderBrush="#33808080"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="150,*">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Форма волны" />
                <ComboBox Grid.Row="0"
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding WaveTypes}"
                          SelectedItem="{Binding SelectedWaveType, Mode=TwoWay}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Margin="0,16,0,0" Text="Громкость" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,16,0,0" ColumnDefinitions="*,70">
                    <Slider Minimum="0"
                            Maximum="1"
                            Value="{Binding Volume, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding VolumeText}" />
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Margin="0,16,0,0" Text="Частота" />
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,16,0,0" ColumnDefinitions="*,70,Auto">
                    <Slider Minimum="80"
                            Maximum="1200"
                            Value="{Binding Frequency, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding FrequencyText}" />
                    <ToggleButton Grid.Column="2"
                                  Margin="14,0,0,0"
                                  Padding="14,4"
                                  Content="Тестовый тон"
                                  IsChecked="{Binding IsToneOn, Mode=TwoWay}"
                                  IsEnabled="{Binding IsRunning}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="20"
                CornerRadius="10"
                BorderBrush="#33808080"
                BorderThickness="1">
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Клавиши первой октавы" FontWeight="SemiBold" />
                    <TextBlock Text="Запустите звук и включите несколько клавиш, чтобы проверить полифонию"
                               FontSize="12"
                               Opacity="0.6" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Notes}" IsEnabled="{Binding IsRunning}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteKeyViewModel">
                            <ToggleButton Classes="key"
                                          Margin="3"
                                          Content="{Binding Name}"
                                          IsChecked="{Binding IsActive, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ActiveNotesText}" FontSize="13" Opacity="0.7" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,20,0,0" Orientation="Horizontal" Spacing="10">
            <Button Content="Запустить звук"
                    MinWidth="150"
                    Command="{Binding StartAudioCommand}"
                    IsEnabled="{Binding !IsRunning}" />
            <Button Content="Остановить звук"
                    MinWidth="150"
                    Command="{Binding StopAudioCommand}"
                    IsEnabled="{Binding IsRunning}" />
        </StackPanel>
    </Grid>
</Window>
